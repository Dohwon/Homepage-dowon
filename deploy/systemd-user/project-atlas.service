[Unit]
Description=Detect and publish Project Atlas changes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dowon/securedir/git/codex/portfolio-homepage
ExecStart=/home/dowon/securedir/git/codex/portfolio-homepage/scripts/project_atlas_scheduled_publish.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077
ReadWritePaths=/home/dowon/securedir/git/codex/.knowledge-worker /home/dowon/securedir/git/codex/portfolio-homepage
ReadOnlyPaths=/home/dowon/.config/project-atlas
