"url":""},{"id":"tag:operations-analytics-unmet-demand-mining","kind":"KnowledgeTag","label":"Operations Analytics / Unmet Demand Mining","summary":"","url":""},{"id":"tag:personalization-emotional-memory","kind":"KnowledgeTag","label":"Personalization / Emotional Memory","summary":"","url":""},{"id":"tag:personalization-user-profile-memory","kind":"KnowledgeTag","label":"Personalization / User Profile Memory","summary":"","url":""},{"id":"tag:product-ux-app-surface","kind":"KnowledgeTag","label":"Product UX / App Surface","summary":"","url":""},{"id":"tag:product-ux-conversational-interface","kind":"KnowledgeTag","label":"Product UX / Conversational Interface","summary":"","url":""},{"id":"tag:prompt-engineering-few-shot","kind":"KnowledgeTag","label":"Prompt Engineering / Few-shot Prompting","summary":"","url":""},{"id":"tag:prompt-engineering-persona","kind":"KnowledgeTag","label":"Prompt Engineering / Persona Prompt","summary":"","url":""},{"id":"tag:prompt-engineering-system","kind":"KnowledgeTag","label":"Prompt Engineering / System Prompt","summary":"","url":""},{"id":"tag:rag-knowledge-graph","kind":"KnowledgeTag","label":"RAG / Knowledge Graph","summary":"","url":""},{"id":"tag:rag-retrieval-context","kind":"KnowledgeTag","label":"RAG / Retrieval Context","summary":"","url":""},{"id":"tag:safety-qa-guardrails","kind":"KnowledgeTag","label":"Safety / QA Guardrails","summary":"","url":""},{"id":"tag:semantic-modeling-function-call-dataset","kind":"KnowledgeTag","label":"Semantic Modeling / Function Call Dataset","summary":"","url":""},{"id":"tag:semantic-modeling-morphological-tagging","kind":"KnowledgeTag","label":"Semantic Modeling / Morphological Tagging","summary":"","url":""},{"id":"tag:semantic-modeling-verb-schema","kind":"KnowledgeTag","label":"Semantic Modeling / Verb Schema","summary":"","url":""},{"id":"project:251104-prompt-auto-evaluation","kind":"Project","label":"Prompt Evaluation Runner","summary":"동일한 테스트 입력으로 프롬프트와 모델 응답을 비교하고, 별도 judge가 케이스별 구조화 판정을 남기는 평가 도구입니다.","url":"/projects/251104-prompt-auto-evaluation"},{"id":"project:260212-feeling-traker","kind":"Project","label":"Mood Capture Desktop Widget","summary":"빠른 상태 기록용 데스크톱 위젯과 웹 관리 화면이 하나의 로컬 데이터 저장소를 공유하는 감정 기록 도구입니다.","url":"/projects/260212-feeling-traker"},{"id":"project:260218-ope-log-anlayze","kind":"Project","label":"Conversation Operations Analyzer","summary":"대용량 대화 운영 데이터를 시간순으로 복원하고 세션별 상태를 분류해 분석 가능한 표로 만드는 파이프라인입니다.","url":"/projects/260218-ope-log-anlayze"},{"id":"project:260315-moe-prompt-routing","kind":"Project","label":"Voice Agent Routing and Evaluation","summary":"복합 음성 요청을 먼저 분류하고 전용 expert와 selector로 넘기는 계층형 라우팅 및 회귀 평가 프로젝트입니다.","url":"/projects/260315-moe-prompt-routing"},{"id":"project:260317-desktop-scheduler","kind":"Project","label":"DeskFlow Scheduler","summary":"Windows 바탕화면에서 바로 여는 월간 체크리스트 스케줄러로, 일정과 상태 및 연기 이력을 로컬에서 관리합니다.","url":"/projects/260317-desktop-scheduler"},{"id":"project:260319-llm-tool-hub","kind":"Project","label":"LLM Tool Hub","summary":"AI 도구, 프로젝트 상태, 공용 작업기억을 한 화면에서 정리하고 정본 메모리에서 도구별 adapter를 생성하는 운영 허브입니다.","url":"/projects/260319-llm-tool-hub"},{"id":"project:260321-memento-mori-archive","kind":"Project","label":"Reflective Atelier","summary":"개인 기록을 다시 탐색하는 아카이브에서 공개 코드와 비공개 런타임 데이터를 분리하고 서버 검증 접근을 적용했습니다.","url":"/projects/260321-memento-mori-archive"},{"id":"project:260322-polite-message-extension","kind":"Project","label":"Polite Message Rewriter","summary":"한국어 초안을 관계와 상황에 맞는 정중한 메시지로 다듬는 브라우저 확장 프로그램입니다.","url":"/projects/260322-polite-message-extension"},{"id":"project:260324-central-memory-prompt-kit","kind":"Project","label":"Central Memory Prompt Kit","summary":"여러 AI 도구와 협업자가 같은 작업 문서를 재사용하도록 중앙 메모리 구조와 프롬프트 템플릿을 묶은 키트입니다.","url":"/projects/260324-central-memory-prompt-kit"},{"id":"project:260329-tmap-clone","kind":"Project","label":"Driver-Focused Navigation PWA","summary":"경로 탐색, 안내, 주변 정보와 주행 기록을 묶고 실제 사용에서 드러난 화면 가림과 카메라 불안정을 반복 보정한 내비게이션 PWA입니다.","url":"/projects/260329-tmap-clone"},{"id":"project:260331-iphone-calculator-clone","kind":"Project","label":"Mobile Calculator Interaction Prototype","summary":"계산 상태와 화면 상태를 분리해 연속 연산과 긴 숫자 표시를 다루는 모바일 계산기 상호작용 프로토타입입니다.","url":"/projects/260331-iphone-calculator-clone"},{"id":"project:260401-wine-cellar-scan","kind":"Project","label":"Wine Cellar Scan","summary":"와인 라벨 사진에서 텍스트와 후보를 제안하고 사용자가 확인해 개인 셀러 기록으로 저장하는 웹 앱입니다.","url":"/projects/260401-wine-cellar-scan"},{"id":"project:260405-execution-harness-system","kind":"Project","label":"Handoff-First Execution Harness","summary":"멀티 에이전트 작업이 보고서로 끝나지 않도록 handoff packet, 실행 증빙과 이중 QA를 강제하는 로컬 실행 하네스입니다.","url":"/projects/260405-execution-harness-system"},{"id":"project:260408-ideal-type-editorial","kind":"Project","label":"Preference Editorial Studio","summary":"선택한 레퍼런스에서 선호 특성을 분리하고 종합해 에디토리얼 문장과 이미지 콘셉트를 만드는 단계형 웹 앱입니다.","url":"/projects/260408-ideal-type-editorial"},{"id":"project:260410-keyboard-piano","kind":"Project","label":"Keyboard Piano","summary":"일반 키보드의 중심 키와 흰건반 및 검은건반 역할을 다시 배치해 피아노 연주 감각을 구현한 브라우저 악기입니다.","url":"/projects/260410-keyboard-piano"},{"id":"project:260413-dictionary-transition-bundle","kind":"Project","label":"Dictionary Transition Bundle","summary":"라우팅과 의미 스키마 작업에 흩어져 있던 dictionary 전환 자산을 별도 소유 경계로 분리한 프로젝트입니다.","url":"/projects/260413-dictionary-transition-bundle"},{"id":"project:260418-japanese-word-study","kind":"Project","label":"Japanese Word Study","summary":"오답, 복습 시점과 신규 항목을 우선순위로 합치고 의미 유사도 채점을 지원하는 일본어 단어 학습 웹 앱입니다.","url":"/projects/260418-japanese-word-study"},{"id":"project:260619-chat-friends","kind":"Project","label":"친구 관계형 AI 채팅 PWA","summary":"여러 가상 친구가 관계 맥락을 유지하도록 응답, 기억 추출과 이미지 요청을 분리한 모바일 우선 AI 채팅 경험입니다.","url":"/projects/260619-chat-friends"},{"id":"project:260621-easy-news","kind":"Project","label":"Easy News","summary":"복잡한 뉴스를 이슈 묶음, 시간 흐름과 생활 영향으로 이해시키고 AI 초안과 운영 검수를 분리한 모바일 웹앱입니다.","url":"/projects/260621-easy-news"},{"id":"project:260626-make-test-set","kind":"Project","label":"한국어 명령 테스트셋 템플릿","summary":"자연어 명령 테스트 데이터를 사람이 검토하기 쉬운 매트릭스 명세로 바꾸고 슬롯 규칙과 생성기를 분리한 데이터 설계 프로젝트입니다.","url":"/projects/260626-make-test-set"},{"id":"project:260725-household-account-book","kind":"Project","label":"가계부 체크리스트","summary":"월별 예산과 실제 지출을 체크리스트로 관리하는 웹앱을 같은 화면의 Windows 데스크톱 앱으로 제공한 프로젝트입니다.","url":"/projects/260725-household-account-book"},{"id":"project:260727-server-app-web-learn-book","kind":"Project","label":"서비스 기술을 이해하는 PM 교재","summary":"서비스가 움직이고 고장 나는 방식을 현실 상황, 그림, 장애 단서와 회의 질문으로 연결하는 비개발 PM용 기술 교재입니다.","url":"/projects/260727-server-app-web-learn-book"},{"id":"project:260802-map-diary","kind":"Project","label":"지도 기록 다이어리 MVP","summary":"가짜 선을 추정하지 않고 공공 공간정보의 원본 도로 Feature를 직접 선택해 방문 기록으로 저장하는 지도 앱입니다.","url":"/projects/260802-map-diary"},{"id":"project:260802-map-diary-v2","kind":"Project","label":"지도 기록 다이어리 v2","summary":"출발지와 도착지의 예상 경로를 미리 보여주되 계획 경로를 실제 방문 기록으로 저장하지 않도록 경계를 분리한 확장 프로젝트입니다.","url":"/projects/260802-map-diary-v2"},{"id":"project:260802-map-diary-v3","kind":"Project","label":"지도 기록 다이어리 v3","summary":"iOS 백그라운드 주행 기록을 네이티브 체크포인트와 웹 지도에 연결하고 원시 위치를 단기 보관하는 확장 프로젝트입니다.","url":"/projects/260802-map-diary-v3"},{"id":"project:260803-ai-office","kind":"Project","label":"AI Office","summary":"여러 AI 역할의 작업 상태와 인수인계를 픽셀 사무실로 시각화하고 사람 승인 전에는 다음 단계로 넘어가지 않는 업무 운영 도구입니다.","url":"/projects/260803-ai-office"},{"id":"project:a2a-lambda","kind":"Project","label":"음성 AI 오케스트레이션 전환","summary":"단일 응답 파이프라인을 메인 라우터와 도메인 전문가 구조로 확장하면서 feature flag와 bridge로 기존 계약을 유지한 전환 프로젝트입니다.","url":"/projects/a2a-lambda"},{"id":"project:a2a-normal","kind":"Project","label":"에이전트 라우팅 및 문서 검색 품질 개선","summary":"대화 요청 라우팅과 문서 검색을 함께 개선하면서 heuristic, live planner와 fallback의 검증 범위를 분리한 품질 프로젝트입니다.","url":"/projects/a2a-normal"},{"id":"project:a2a-test","kind":"Project","label":"에이전트 전문가 라우팅 테스트 체계","summary":"상위 라우터와 하위 전문가의 책임을 분리하고 최신 기준셋, 과거 산출물과 재실행 결과를 관리하는 테스트 체계입니다.","url":"/projects/a2a-test"},{"id":"project:gemini-multiturn-tester-v3","kind":"Project","label":"멀티턴 LLM 테스트 도구","summary":"대화 이력과 런타임 태그를 포함한 LLM 멀티턴 테스트를 시나리오와 스프레드시트에서 재현하는 실행 도구입니다.","url":"/projects/gemini-multiturn-tester-v3"},{"id":"project:operation-log-analayzer","kind":"Project","label":"운영 로그 기반 제품 인사이트 분석","summary":"운영 대화 기록의 인코딩, 중복과 지표 정의를 검증하고 실패 유형을 제품 개선 backlog로 연결하는 분석 파이프라인입니다.","url":"/projects/operation-log-analayzer"},{"id":"project:semantic-verb-schema","kind":"Project","label":"동사 기반 의미 스키마 학습 자산","summary":"기능 호출 학습 자산을 형태소 태깅, 동사 inventory와 의미 필터링 단계로 분리해 정리한 NLU 프로젝트입니다.","url":"/projects/semantic-verb-schema"},{"id":"project:todack","kind":"Project","label":"Todack","summary":"기분 기록, 통계, 대화와 알림을 웹, Windows와 모바일에서 같은 API로 연결하는 멀티클라이언트 감정 지원 앱입니다.","url":"/projects/todack"},{"id":"technology:a2a","kind":"Technology","label":"A2A","summary":"","url":""},{"id":"technology:audio%20samples","kind":"Technology","label":"Audio Samples","summary":"","url":""},{"id":"technology:bm25","kind":"Technology","label":"BM25","summary":"","url":""},{"id":"technology:capacitor","kind":"Technology","label":"Capacitor","summary":"","url":""},{"id":"technology:chrome%20extension","kind":"Technology","label":"Chrome Extension","summary":"","url":""},{"id":"technology:codex%20cli","kind":"Technology","label":"Codex CLI","summary":"","url":""},{"id":"technology:core%20location","kind":"Technology","label":"Core Location","summary":"","url":""},{"id":"technology:css","kind":"Technology","label":"CSS","summary":"","url":""},{"id":"technology:csv","kind":"Technology","label":"CSV","summary":"","url":""},{"id":"technology:dictionary%20assets","kind":"Technology","label":"Dictionary Assets","summary":"","url":""},{"id":"technology:dotenv","kind":"Technology","label":"dotenv","summary":"","url":""},{"id":"technology:electron","kind":"Technology","label":"Electron","summary":"","url":""},{"id":"technology:embeddings","kind":"Technology","label":"Embeddings","summary":"","url":""},{"id":"technology:excel","kind":"Technology","label":"Excel","summary":"","url":""},{"